{
  "realm": "bibliogest",
  "enabled": true,
  "displayName": "BiblioGest",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and digits(1) and lowerCase(1) and upperCase(1)",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "LEITOR"
      },
      {
        "name": "BIBLIOTECARIO"
      },
      {
        "name": "default-roles-bibliogest",
        "composite": true,
        "composites": {
          "realm": [
            "LEITOR"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-bibliogest"
  },
  "clients": [
    {
      "clientId": "bibliogest-react",
      "name": "BiblioGest React",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://@@APP_HOST@@/"
      ],
      "webOrigins": [
        "https://@@APP_HOST@@"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://@@APP_HOST@@/"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-acervo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bibliogest-acervo",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-reservas",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bibliogest-reservas",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "bibliogest-react",
      "roles": [
        "LEITOR",
        "BIBLIOTECARIO"
      ]
    }
  ]
}
